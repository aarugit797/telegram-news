# Database (local Docker Postgres for now)
DATABASE_URL=postgresql+asyncpg://techintel:localdevpassword@localhost:5432/techintel_news

# Redis (local Docker Redis for now)
REDIS_URL=redis://localhost:6379/0

# LLM - Google AI Studio (free tier, no card required):
# https://aistudio.google.com/apikey
#
# Comma-separated, ONE KEY PER GOOGLE CLOUD PROJECT. Quota is enforced
# per project (measured: one key returned 429 while its siblings served
# normally), so the pool rotates across projects to multiply capacity.
# Keys from the SAME project share one quota and buy nothing.
# Add or remove entries freely - the count is not hardcoded anywhere.
GEMINI_API_KEYS=key_for_project_1,key_for_project_2,key_for_project_3

# Overflow provider, used only once every Gemini credential is spent:
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Messaging channel: "telegram" or "whatsapp".
# Telegram is the default - Twilio's WhatsApp sandbox rejects LLM-written
# text on a trial account (error 21654, business-initiated messages need
# pre-approved templates). Switch to "whatsapp" once a paid account and an
# approved WhatsApp Business Account exist; no code change needed.
ACTIVE_CHANNEL=telegram

# Telegram bot token from @BotFather (https://t.me/BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=123456789:your_telegram_bot_token_here

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Embeddings
VOYAGE_API_KEY=your_voyage_api_key_here

# Web search tool (responder)
TAVILY_API_KEY=your_tavily_api_key_here
GITHUB_TOKEN =your_github_token_here
# Observability
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=tech-intel-agent
SENTRY_DSN=your_sentry_dsn_here

# Second database (Conversation DB) - separate from News DB above
CONVERSATION_DATABASE_URL=postgresql+asyncpg://techintel:localdevpassword@localhost:5432/techintel_conversation
