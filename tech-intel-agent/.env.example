# Observability
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=tech-intel-agent
SENTRY_DSN=your_sentry_dsn_here

# Second database (Conversation DB) - separate from News DB above
CONVERSATION_DATABASE_URL=postgresql+asyncpg://techintel:localdevpassword@localhost:5432/techintel_conversation
